{
  "permissions": {
    "allow": [
      "Bash(npm run tsc)",
      "Bash(npx tsc *)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run tsc *)",
      "Bash(npm run gen:configs)",
      "Bash(npm run chore)",
      "Bash(npm run chore addMissingColumnIds)",
      "Bash(npm run chore fillMissingRowIds)",
      "Bash(npm run probe)",
      "Bash(npm run probe *)",
      "Bash(npm run -s probe *)",
      "Bash(npx prettier --check *)",
      "Bash(npx eslint *)",
      "Bash(gh label list *)",
      "Bash(gh issue edit *)",
      "mcp__gsheets__get_sheet_data",
      "mcp__gsheets__list_sheets"
    ],
    "ask": [
      "Bash(npm run chore * --send*)"
    ],
    "deny": [
      "Read(./src/01_SpreadsheetSchema/generated/columnConfigs.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bashReadGuard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/generatedEditWarning.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_response.filePath // .tool_input.file_path') && cd \"$CLAUDE_PROJECT_DIR\" && node_modules/.bin/prettier --write --ignore-unknown --log-level warn \"$f\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/readCountNudge.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/readCountNudge.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/contextSizeNudge.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
