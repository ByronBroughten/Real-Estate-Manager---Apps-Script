{
  "permissions": {
    "allow": [
      "Bash(npm run tsc)",
      "Bash(npx tsc *)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run tsc *)",
      "Bash(npm run app:gen:configs)",
      "Bash(npm run app:chore)",
      "Bash(npm run app:chore addMissingColumnIds)",
      "Bash(npm run app:chore fillMissingRowIds)",
      "Bash(npm run app:probe)",
      "Bash(npm run app:probe *)",
      "Bash(npm run -s app:probe *)",
      "Bash(npm run dev:gen:configs)",
      "Bash(npm run dev:chore)",
      "Bash(npm run dev:chore *)",
      "Bash(npm run dev:probe)",
      "Bash(npm run dev:probe *)",
      "Bash(npm run -s dev:probe *)",
      "Bash(npm run dev:build)",
      "Bash(npm run dev:push)",
      "Bash(npm run dev:run *)",
      "Bash(npx prettier --check *)",
      "Bash(npx eslint *)",
      "Bash(gh label list *)",
      "Bash(gh issue edit *)",
      "mcp__gsheets__get_sheet_data",
      "mcp__gsheets__list_sheets"
    ],
    "ask": [
      "Bash(npm run app:chore * --send*)",
      "Bash(npm run app:build*)",
      "Bash(clasp deploy*)",
      "Bash(npx clasp deploy*)",
      "mcp__gsheets__create_spreadsheet",
      "mcp__gsheets__share_spreadsheet"
    ],
    "deny": [
      "Read(./packages/*/src/generated/columnConfigs.ts)",
      "Read(./packages/*/dev/generated/columnConfigs.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bashReadGuard.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__gsheets__update_cells|mcp__gsheets__batch_update_cells|mcp__gsheets__create_sheet",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pinnedTargetGuard.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/generatedEditWarning.ts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agentsCostNudge.ts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/styleGate.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat) && f=$(printf '%s' \"$input\" | jq -r '.tool_response.filePath // .tool_input.file_path') && cd \"$CLAUDE_PROJECT_DIR\" && { node_modules/.bin/prettier --write --ignore-unknown --log-level warn \"$f\" 2>/dev/null || true; } && printf '%s' \"$input\" | node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lintFeedback.ts\"",
            "timeout": 40,
            "statusMessage": "Formatting with Prettier and ESLint"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/readCountNudge.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/styleGate.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/readCountNudge.ts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/contextSizeNudge.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
