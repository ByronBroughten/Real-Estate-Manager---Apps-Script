{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/styleGate.ts",
        "matcher": "Write|StrReplace|Edit",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/styleGate.ts",
        "matcher": "Read",
        "timeout": 10
      }
    ]
  }
}
