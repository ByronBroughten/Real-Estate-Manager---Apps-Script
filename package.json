{
  "name": "byrorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tsc": "tsc -p . && npm run tsc --workspaces",
    "lint": "eslint . && npm run -s lint:docs",
    "lint:docs": "node scripts/lintDocs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "app:chore": "npm run chore -w real-estate-app --",
    "app:gen:configs": "npm run gen:configs -w real-estate-app --",
    "app:probe": "npm run probe -w real-estate-app --",
    "app:build": "npm run build -w real-estate-app --",
    "dev:chore": "npm run chore -w @byronbroughten/sheets-framework --",
    "dev:gen:configs": "npm run gen:configs -w @byronbroughten/sheets-framework --",
    "dev:probe": "npm run probe -w @byronbroughten/sheets-framework --",
    "dev:build": "npm run build -w @byronbroughten/sheets-framework --",
    "dev:push": "npm run push -w @byronbroughten/sheets-framework --",
    "dev:run": "npm run run -w @byronbroughten/sheets-framework --"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/google-apps-script": "^2.0.11",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.35.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "3.9.6",
    "rollup": "^4.54.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.1.11"
  }
}
