{
  "name": "real-estate-manager-apps-script",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "tsc": "tsc && tsc -p tsconfig.framework.json",
    "lint": "eslint src && npm run -s lint:docs",
    "lint:docs": "node scripts/lintDocs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "rollup --config && clasp push",
    "gen:configs": "tsx scripts/genConfigs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "chore": "tsx scripts/chore.mjs",
    "probe": "node scripts/sheetsProbe.mjs",
    "app:chore": "npm run chore -- --target app",
    "app:gen:configs": "npm run gen:configs -- --target app",
    "app:probe": "npm run -s probe -- --target app",
    "app:build": "npm run build",
    "dev:chore": "npm run chore -- --target dev",
    "dev:gen:configs": "npm run gen:configs -- --target dev",
    "dev:probe": "npm run -s probe -- --target dev",
    "dev:build": "echo 'dev:build: there is no dev Apps Script project yet; it arrives with slice L of #129.' >&2 && exit 1",
    "dev:push": "echo 'dev:push: there is no dev Apps Script project yet; it arrives with slice L of #129.' >&2 && exit 1",
    "dev:run": "echo 'dev:run: there is no dev Apps Script project yet; it arrives with slice L of #129.' >&2 && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "real-estate-manager-apps-script"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/google-apps-script": "^2.0.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.35.0",
    "prettier": "3.9.6",
    "rollup": "^4.54.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.1.11"
  }
}
