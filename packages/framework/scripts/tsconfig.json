{
  // The Node program: scripts/ run under tsx, plus the three JS files that run outside it. Self-contained, since scripts/ ships in the package.
  "compilerOptions": {
    "target": "ES2023",
    "module": "preserve",
    "lib": ["esnext"],
    "types": ["node", "google-apps-script"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true
  },
  "include": ["**/*.ts", "**/*.js", "../src/TypeDeclarations/**/*.ts"]
}
